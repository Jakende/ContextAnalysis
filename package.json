{
  "name": "urban-context-analysis",
  "version": "0.1.0",
  "description": "Lightweight urban context analysis MVP for XL/L/M geospatial fact sheets.",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "preprocess:bkg": "node scripts/preprocess/preprocess-bkg-boundaries.mjs",
    "preprocess:fua": "node scripts/preprocess/preprocess-gisco-fua.mjs",
    "preprocess:dem": "node scripts/preprocess/preprocess-dem-contours.mjs",
    "preprocess:buildings": "node scripts/preprocess/preprocess-building-fallback.mjs",
    "preprocess:gtfs": "node scripts/preprocess/preprocess-gtfs-stops.mjs",
    "preprocess:gtfs-lines": "node scripts/preprocess/preprocess-gtfs-lines.mjs",
    "preprocess:thematic": "node scripts/preprocess/preprocess-thematic-geojson.mjs",
    "preprocess:point-cache": "node scripts/preprocess/resolve-point-cache.mjs",
    "preprocess:benchmarks": "node scripts/preprocess/preprocess-benchmark-peers.mjs",
    "release:data-manifest": "node scripts/release/build-data-release-manifest.mjs",
    "test:data-release": "node scripts/release/validate-data-release-manifest.mjs",
    "test:data-sources": "node scripts/validate/test-data-sources.mjs",
    "test:data-sources:regression": "node scripts/validate/test-data-sources.mjs --preset regression",
    "test:benchmark": "node scripts/validate/test-benchmark-contract.mjs",
    "test:benchmark-ingestion": "node scripts/validate/test-benchmark-ingestion.mjs",
    "test:kpi": "node scripts/validate/test-kpi-rules.mjs",
    "test:project-area": "node scripts/validate/test-project-area.mjs",
    "test:spatial-area": "node scripts/validate/test-spatial-area.mjs",
    "test:scenario": "node scripts/validate/test-scenario.mjs",
    "validate:ui": "python3 scripts/validate/validate_ui_css.py src/styles/design-system.css src/styles/app.css"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "maplibre-gl": "^5.24.0",
    "playwright": "^1.59.1",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.14.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "devDependencies": {
    "@types/node": "^25.8.0"
  }
}
