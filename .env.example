# Local runtime configuration. Copy to .env.local and fill only on your machine.

# Optional immutable geodata release root. It must contain processed/.
# Leave unset for the development default at /data.
VITE_GEODATA_BASE_URL=

# Build-time only: set false when the geodata release is deployed separately.
UCA_INCLUDE_GEODATA=true

# Optional staging directory for builds when the default dist/ tree is on a
# synced filesystem that cannot be emptied atomically. CI should use a fresh,
# explicitly scoped path.
# UCA_OUT_DIR=/private/tmp/uca-ui-dist

# Ollama reports
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1
VITE_REPORT_LANGUAGE=en
VITE_OLLAMA_TIMEOUT_MS=120000

# Optional routed mobility catchments. Kept server-only by the local proxy.
OPENROUTESERVICE_API_KEY=

# Optional Copernicus Data Space / CDSE S3 access for Urban Atlas preprocessing.
# These are read by the local Vite server and preprocessing scripts, not exposed to the client.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default
AWS_S3_ENDPOINT=eodata.dataspace.copernicus.eu
AWS_VIRTUAL_HOSTING=FALSE

# Optional DEM preprocessing
OPENTOPOGRAPHY_API_KEY=
